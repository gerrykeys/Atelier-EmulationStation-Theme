            <faintColor>2E2B28</faintColor>
            <accentColor>C9AB79</accentColor>
            <artColor>E9E2D6E6</artColor>
            <placeholderColor>EFE9DF1A</placeholderColor>
            <ambientImage>./../core/images/ambient-glow.png</ambientImage>
            <ambientColor>C9AB792E</ambientColor>
            <ambientTileImage>./../core/images/ambient-glow-tile.png</ambientTileImage>
            <selectionGlowColor>C9AB7966</selectionGlowColor>
            <gridDimOpacity>0.6</gridDimOpacity>
            <atmosphereVisible>false</atmosphereVisible>
            <atmosphereOpacity>0</atmosphereOpacity>
            <atmosphereSaturation>1</atmosphereSaturation>
            <roomLightVisible>false</roomLightVisible>
            <roomLightColor>00000000</roomLightColor>
            <listFadeVisible>true</listFadeVisible>
        </variables>
    </colorScheme>

