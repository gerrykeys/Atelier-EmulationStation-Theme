<!--
    Gallery variant: a row of box covers with the selected title set beneath it.
    Games without a cover are shown as plain typographic covers.
    Item sizes per cover shape are set in layout/gallery/.
-->

<theme>
    <view name="gamelist">
        <text name="header">
            <text>${system.fullName}</text>
            <fontPath>${fontCaps}</fontPath>
            <fontSize>${capsSize}</fontSize>
            <color>${mutedColor}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>left</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <container>true</container>
            <containerType>horizontal</containerType>
            <containerStartDelay>2.5</containerStartDelay>
            <containerScrollSpeed>0.7</containerScrollSpeed>
            <zIndex>40</zIndex>
        </text>
        <!-- The system's controller drawing, set just before the header text -->
        <image name="headerArt">
            <path>${artPath}</path>
            <default>${artFallback}</default>
            <color>${textColor}</color>
            <interpolation>linear</interpolation>
            <zIndex>40</zIndex>
        </image>
        <gamelistinfo name="gamelistInfo">
            <fontPath>${fontCapsLight}</fontPath>
            <fontSize>${capsSize}</fontSize>
            <color>${mutedColor}</color>
            <horizontalAlignment>right</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>45</zIndex>
        </gamelistinfo>

        <carousel name="gamelistCarousel">
            <type>horizontal</type>
            <imageType>cover</imageType>
            <itemScale>1.22</itemScale>
            <itemVerticalAlignment>center</itemVerticalAlignment>
            <imageFit>contain</imageFit>
            <imageInterpolation>linear</imageInterpolation>
            <unfocusedItemOpacity>0.6</unfocusedItemOpacity>
            <unfocusedItemSaturation>0.85</unfocusedItemSaturation>
            <fastScrolling>true</fastScrolling>
            <color>00000000</color>
            <fontPath>${tileFont}</fontPath>
            <fontSize>${coverTextSize}</fontSize>
            <textColor>${textColor}</textColor>
            <textSelectedColor>${titleColor}</textSelectedColor>
            <textBackgroundColor>${surfaceColor}</textBackgroundColor>
            <textSelectedBackgroundColor>${surfaceColor}</textSelectedBackgroundColor>
            <textRelativeScale>0.82</textRelativeScale>
            <lineSpacing>1.15</lineSpacing>
            <systemNameSuffix>false</systemNameSuffix>
            <zIndex>50</zIndex>
        </carousel>

        <text name="gameTitle">
            <metadata>name</metadata>
            <systemNameSuffix>false</systemNameSuffix>
            <fontPath>${fontDisplay}</fontPath>
            <fontSize>${galleryTitleSize}</fontSize>
            <color>${titleColor}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <container>true</container>
            <containerType>horizontal</containerType>
            <containerStartDelay>2.5</containerStartDelay>
            <containerScrollSpeed>0.7</containerScrollSpeed>
            <zIndex>40</zIndex>
        </text>

        <!-- Long values scroll rather than ending in an ellipsis, see gamelist-details.xml -->
        <text name="genre, fileTags, developer">
            <container>true</container>
            <containerType>horizontal</containerType>
            <containerStartDelay>2.5</containerStartDelay>
            <containerScrollSpeed>0.7</containerScrollSpeed>
        </text>
        <text name="labelReleased, labelDeveloper, labelPlayers">
            <metadataElement>true</metadataElement>
            <fontPath>${fontCaps}</fontPath>
            <fontSize>${labelSize}</fontSize>
            <color>${mutedColor}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>40</zIndex>
        </text>
        <text name="labelReleased">
            <text>${langReleased}</text>
        </text>
        <text name="labelDeveloper">
            <text>${langDeveloper}</text>
        </text>
        <text name="labelPlayers">
            <text>${langPlayers}</text>
        </text>
        <text name="developer, players">
            <fontPath>${fontText}</fontPath>
            <fontSize>${valueSize}</fontSize>
            <color>${titleColor}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>40</zIndex>
        </text>
        <text name="developer">
            <metadata>developer</metadata>
            <defaultValue>—</defaultValue>
        </text>
        <text name="players">
            <metadata>players</metadata>
            <defaultValue>—</defaultValue>
        </text>
        <datetime name="releaseDate">
            <metadata>releasedate</metadata>
            <format>%Y</format>
            <defaultValue>—</defaultValue>
            <fontPath>${fontText}</fontPath>
            <fontSize>${valueSize}</fontSize>
            <color>${titleColor}</color>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>40</zIndex>
        </datetime>
        <text name="genre">
            <metadata>genre</metadata>
            <defaultValue>:space:</defaultValue>
            <fontPath>${fontCaps}</fontPath>
            <fontSize>${capsSize}</fontSize>
            <color>${accentColor}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>40</zIndex>
        </text>
        <!-- Tags from the file name beneath the covers, see gamelist-details.xml -->
        <text name="fileTags">
            <metadata>physicalName</metadata>
            <metadataElement>true</metadataElement>
            <fontPath>${fontTags}</fontPath>
            <fontSize>${tagSize}</fontSize>
            <color>${mutedColor}</color>
            <letterCase>uppercase</letterCase>
            <horizontalAlignment>center</horizontalAlignment>
            <verticalAlignment>center</verticalAlignment>
            <zIndex>40</zIndex>
        </text>
        <badges name="badges">
            <horizontalAlignment>center</horizontalAlignment>
            <direction>row</direction>
            <lines>1</lines>
            <itemsPerLine>9</itemsPerLine>
            <slots>favorite, completed, kidgame, broken, controller, altemulator, manual, folder, collection</slots>
            <controllerPos>0.5 0.5</controllerPos>
            <controllerSize>0.56</controllerSize>
            <customBadgeIcon badge="favorite">./../core/badges/favorite.svg</customBadgeIcon>
            <customBadgeIcon badge="completed">./../core/badges/completed.svg</customBadgeIcon>
            <customBadgeIcon badge="kidgame">./../core/badges/kidgame.svg</customBadgeIcon>
            <customBadgeIcon badge="broken">./../core/badges/broken.svg</customBadgeIcon>
            <customBadgeIcon badge="controller">./../core/badges/controller.svg</customBadgeIcon>
            <customBadgeIcon badge="altemulator">./../core/badges/altemulator.svg</customBadgeIcon>
            <customBadgeIcon badge="manual">./../core/badges/manual.svg</customBadgeIcon>
            <customBadgeIcon badge="folder">./../core/badges/folder.svg</customBadgeIcon>
            <customBadgeIcon badge="collection">./../core/badges/collection.svg</customBadgeIcon>
            <folderLinkPos>0.5 0.56</folderLinkPos>
            <folderLinkSize>0.42</folderLinkSize>
            <badgeIconColor>${accentColor}</badgeIconColor>
            <controllerIconColor>${accentColor}</controllerIconColor>
            <folderLinkIconColor>${accentColor}</folderLinkIconColor>
            <interpolation>linear</interpolation>
            <zIndex>45</zIndex>
        </badges>

        <!-- Achievement progress, as in gamelist-details.xml -->
        <image name="raProgress">
            <imageType>physicalmedia</imageType>
            <color>${accentColor}</color>
            <interpolation>linear</interpolation>
            <metadataElement>true</metadataElement>
            <visible>${raProgressVisible}</visible>
            <zIndex>45</zIndex>
        </image>
    </view>
</theme>
