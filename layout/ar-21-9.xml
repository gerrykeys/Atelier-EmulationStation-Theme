<!--
    Layout for 21:9 displays (for example 2560x1080, 3440x1440).

    Grid: outer margin 0.07, header at 0.085, content from 0.175 to 0.845, footer at 0.93.
    Index columns: list 0.07-0.305, media 0.345-0.6, details 0.645-0.93.
    Grid variant: covers 0.07-0.565, then title, description and the media card
    (0.51-0.82) with the facts beside it in the 0.61-0.93 column.
-->

<theme>
    <!-- At the extra large font size the help prompts need the whole footer, so the
         system status moves up to the header line, with the clock to its left -->
    <variables>
        <statusPos>0.93 0.93</statusPos>
        <clockPos>0.93 0.085</clockPos>
    </variables>
    <fontSize name="x-large">
        <variables>
