<!--
    Index variant without videos: a single still image filling the rounded card.
    Covers are left out as cropping them to the card would cut them badly. Miximages come
    after the screenshot and title screen, for games with neither.
-->

<theme>
    <view name="gamelist">
        <image name="gameImage">
            <origin>0.5 0.5</origin>
            <imageType>screenshot, titlescreen, miximage</imageType>
            <scrollFadeIn>true</scrollFadeIn>
            <interpolation>nearest</interpolation>
            <zIndex>30</zIndex>
        </image>
    </view>
</theme>
