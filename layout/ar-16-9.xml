<!--
    Layout for 16:9 and 16:10 displays (for example 1920x1080, 2560x1440, 3840x2160).

    Grid: outer margin 0.06, header at 0.085, content from 0.175 to 0.885, footer at 0.93.
    Index: list 0.06-0.36, then title, framed media and facts in the 0.41-0.94 column.
    Grid variant: covers 0.06-0.495, then title, description and the media card
    (0.51-0.82) with the facts beside it in the 0.545-0.94 column.
-->

<theme>
    <!-- The clock ends the header line, with Wi-Fi and then the battery to its left, one
         entry spacing (0.008) apart. Wi-Fi is placed by the widest time, 00:00, which is
         3.37 em of the status size; other times leave a little more room. The icons are
         as wide as they are tall, a share of the screen height, so these values are
         halfway between 16:9 and 16:10 -->
    <variables>
        <wifiPos>0.884 0.085</wifiPos>
        <statusPos>0.862 0.085</statusPos>
    </variables>
    <fontSize name="small">
        <variables>
            <wifiPos>0.89 0.085</wifiPos>
            <statusPos>0.87 0.085</statusPos>
        </variables>
    </fontSize>
    <fontSize name="large">
        <variables>
            <wifiPos>0.876 0.085</wifiPos>
            <statusPos>0.851 0.085</statusPos>
        </variables>
    </fontSize>
    <fontSize name="x-large">
